<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#008B0000" />
            <corners android:radius="20dp" />
            <stroke android:width="6dp" android:color="#55FF2438" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#008B0000" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="#CCFF3048" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#8B0000" android:endColor="#4A0000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>